{
  "name": "hotel-chromium-islands",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "dev": "ASSET_MODE=vite nx run-many -t serve,assets-dev --projects=web --parallel=2",
    "dev:snapshots": "pnpm build && SNAPSHOT_MODE=on nx run-many -t serve --projects=web,snapshot-worker --parallel=2",
    "build": "nx run web:assets-build && nx run web:build",
    "test": "nx run-many -t test",
    "test:e2e": "nx run e2e:e2e",
    "lint": "nx run web:lint && pnpm lint:csharp",
    "lint:csharp": "dotnet build apps/web/web.csproj --no-dependencies && dotnet build apps/web.tests/web.tests.csproj --no-dependencies",
    "check": "nx run web:check && pnpm check:csharp",
    "check:csharp": "dotnet format whitespace apps/web/web.csproj --verify-no-changes && dotnet format whitespace apps/web.tests/web.tests.csproj --verify-no-changes && node scripts/check-dotnet-lines.mjs",
    "format:csharp": "dotnet format whitespace apps/web/web.csproj && dotnet format whitespace apps/web.tests/web.tests.csproj",
    "typecheck": "nx run web:typecheck",
    "images": "nx run web:images",
    "db:migrate": "nx run web:migrate",
    "db:seed": "nx run web:seed",
    "snapshots:all": "nx run snapshot-worker:publish",
    "storybook": "nx run web:storybook",
    "build-storybook": "nx run web:build-storybook",
    "lighthouse": "nx run e2e:lighthouse"
  },
  "dependencies": {
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-image": "3.31.0",
    "@tiptap/extension-table": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "bulma": "1.0.4",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.39.0",
    "pg": "8.16.3",
    "playwright": "1.62.1",
    "react": "19.2.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@nx/dotnet": "23.2.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "nx": "23.2.1",
    "oxc-transform-react": "0.151.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "sass": "1.104.1",
    "storybook": "10.6.0",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "vite": "8.0.0",
    "vitest": "4.1.11"
  }
}
