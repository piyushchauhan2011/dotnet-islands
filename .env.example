# Copy to .env and replace secrets before starting api or snapshot-worker.
# Only postgres is needed for the initial workspace/bootstrap step.
ASPNETCORE_ENVIRONMENT=Development
POSTGRES_USER=hotel
POSTGRES_PASSWORD=replace-with-local-database-password
POSTGRES_DB=hotel
DATABASE_URL=postgresql://hotel:replace-with-local-database-password@localhost:5432/hotel
# Never point automated integration tests at DATABASE_URL.
TEST_DATABASE_URL=postgresql://hotel:replace-with-local-database-password@localhost:5432/hotel_test

# Shared credential for api /_snapshot-source and the trusted worker only.
# Generate independently of admin credentials: openssl rand -hex 32
SNAPSHOT_INTERNAL_TOKEN=replace-with-a-random-64-character-hex-token
SNAPSHOT_API_ORIGIN=http://localhost:5000
# Absolute canonical public origin, never the internal Docker API hostname.
PUBLIC_ORIGIN=http://localhost:5000
MEDIA_DIR=./data/media
DATA_PROTECTION_KEYS_DIR=./data/keys

# Initial admin seed only. Seeding must not replace credentials on existing users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# When running Vite directly on the host, its /api proxy targets this URL.
VITE_API_ORIGIN=http://localhost:5000
