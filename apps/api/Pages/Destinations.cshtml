@page "/destinations"
@model DestinationsModel
<div class="app-container destination-page destination-page--index">
    <header class="destination-page__header">
        <p class="eyebrow">FIELD GUIDES</p>
        <h1 class="display-title">Places worth<br /><em>knowing slowly.</em></h1>
        <p>
            Independent stays, local rituals, and considered notes for a more
            rewarding arrival.
        </p>
    </header>
    <div class="destination-page__grid">
        @foreach (var destination in Model.Items)
        {
            <partial name="_DestinationCard" model="destination" />
        }
    </div>
</div>
