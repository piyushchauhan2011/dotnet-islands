@model SearchFormView
@{
    var initial = Model.Initial;
    var destinations = Model.Destinations.Select(x => new { x.Name, x.Slug });
    var initialProps = new
    {
        destination = initial?.Destination,
        query = initial?.Query,
        checkIn = initial?.CheckIn,
        checkOut = initial?.CheckOut,
        adults = initial?.Adults ?? 2,
        children = initial?.Children ?? 0
    };
    var props = PublicPageModel.IslandProps(new
    {
        destinations,
        initial = initialProps,
        compact = Model.Compact
    });
}
<div data-island="SearchForm" data-hydrate="load" data-props="@props"></div>
<form data-fallback-for="SearchForm"
      class="search-form @(Model.Compact ? "search-form--compact" : "")"
      action="/search" method="get" aria-label="Search hotels">
    <div class="search-form__field search-form__field--destination">
        <label class="label" for="search-destination">Destination</label>
        <div class="select">
            <select id="search-destination" name="destination">
                <option value="">Anywhere</option>
                @foreach (var destination in Model.Destinations)
                {
                    var selected = initial?.Destination == destination.Slug;
                    <option value="@destination.Slug"
                            selected="@selected">@destination.Name</option>
                }
            </select>
        </div>
    </div>
    <div class="search-form__field">
        <label class="label" for="search-check-in">Check in</label>
        <input class="input" id="search-check-in" type="date"
               name="checkIn" value="@initial?.CheckIn" />
    </div>
    <div class="search-form__field">
        <label class="label" for="search-check-out">Check out</label>
        <input class="input" id="search-check-out" type="date"
               name="checkOut" value="@initial?.CheckOut" />
    </div>
    <div class="search-form__field">
        <label class="label" for="search-adults">Guests</label>
        <div class="select">
            <select id="search-adults" name="adults">
                @for (var count = 1; count <= 6; count++)
                {
                    var selected = count == (initial?.Adults ?? 2);
                    <option value="@count"
                            selected="@selected">@count adult@(count > 1 ? "s" : "")</option>
                }
            </select>
        </div>
    </div>
    <input type="hidden" name="children" value="@(initial?.Children ?? 0)" />
    <button type="submit" class="button is-primary search-form__submit">Search</button>
</form>
