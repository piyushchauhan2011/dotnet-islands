@model SearchFormView
@{
    var initial = Model.Initial;
    var destinations = Model.Destinations.Select(x => new { x.Name, x.Slug });
    var initialProps = new
    {
        destination = initial?.Destination,
        query = initial?.Query,
        checkIn = initial?.CheckIn,
        checkOut = initial?.CheckOut,
        adults = initial?.Adults ?? 2,
        children = initial?.Children ?? 0
    };
    var props = PublicPageModel.IslandProps(new
    {
        destinations,
        initial = initialProps,
        compact = Model.Compact
    });
}
<div data-island="SearchForm" data-hydrate="load" data-props="@props"></div>
