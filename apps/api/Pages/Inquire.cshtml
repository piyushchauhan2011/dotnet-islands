@page "/inquire"
@model InquireModel
@{
    var islandProps = PublicPageModel.IslandProps(new
    {
        hotel = new
        {
            Model.Data.Hotel.Id,
            Model.Data.Hotel.Name,
            Model.Data.Hotel.Slug
        },
        room = Model.Data.Room is null
            ? null
            : new { Model.Data.Room.Id, Model.Data.Room.Name },
        offer = Model.Data.Offer is null
            ? null
            : new { Model.Data.Offer.Id, Model.Data.Offer.Title }
    });
}
<div class="app-container inquiry-page">
    <div class="inquiry-page__intro">
        <p class="eyebrow">PLAN YOUR STAY</p>
        <h1 class="display-title">Tell us about <br /><em>your journey.</em></h1>
        <p>This is a request, not a confirmed reservation. No payment is taken.</p>
        <article class="card inquiry-page__hotel">
            <img src="@Model.Data.Hotel.HeroImage"
                 alt="@Model.Data.Hotel.Name"
                 width="130" height="112" />
            <div class="card-content">
                <span>Your selected stay</span>
                <strong>@Model.Data.Hotel.Name</strong>
                <small>@Model.Data.Hotel.Address</small>
                @if (Model.Data.Room is not null)
                {
                    <small>Room: @Model.Data.Room.Name</small>
                }
                @if (Model.Data.Offer is not null)
                {
                    <small>Offer: @Model.Data.Offer.Title</small>
                }
            </div>
        </article>
    </div>
    <section class="inquiry-page__form" aria-label="Send an inquiry">
        <div data-island="InquiryForm"
             data-hydrate="load"
             data-props="@islandProps"></div>
        <div data-fallback-for="InquiryForm"
             role="status"
             class="notification is-warning">
            Sending an inquiry requires JavaScript. No inquiry has been
            submitted; please enable JavaScript or contact the hotel directly.
        </div>
    </section>
</div>
