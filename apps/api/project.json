{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "root": "apps/api",
  "targets": {
    "assets-build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/api/wwwroot/assets"],
      "options": { "command": "pnpm exec vite build", "cwd": "apps/api/ClientApp" }
    },
    "assets-dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec vite --host 0.0.0.0 --port 3000", "cwd": "apps/api/ClientApp" },
      "cache": false,
      "continuous": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/api/api.csproj --no-launch-profile -- --urls ${API_LISTEN_URL:-http://localhost:5000}",
        "cwd": "."
      },
      "cache": false,
      "continuous": true
    },
    "publish": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/apps/api/bin/publish"],
      "options": {
        "command": "dotnet publish apps/api/api.csproj --configuration Release --output apps/api/bin/publish",
        "cwd": "."
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/api/api.csproj -- migrate",
        "cwd": "."
      },
      "cache": false
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project apps/api/api.csproj -- seed",
        "cwd": "."
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsc --noEmit -p apps/api/ClientApp/tsconfig.json", "cwd": "." }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec oxlint apps/api/ClientApp/src apps/api/ClientApp/vite.config.ts", "cwd": "." }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec oxfmt --check apps/api/ClientApp/src apps/api/ClientApp/vite.config.ts", "cwd": "." }
    },
    "images": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec tsx scripts/generate-images.ts", "cwd": "." }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec storybook dev -c .storybook -p 6006", "cwd": "apps/api/ClientApp" },
      "cache": false,
      "continuous": true
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm exec storybook build -c .storybook -o storybook-static", "cwd": "apps/api/ClientApp" },
      "outputs": ["{workspaceRoot}/apps/api/ClientApp/storybook-static"]
    }
  }
}
