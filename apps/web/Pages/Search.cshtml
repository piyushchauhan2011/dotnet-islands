@page "/search"
@model SearchModel
@{
    var f = Model.Data.Filters;
}
<div class="search-page">
    <div class="app-container">
        <header class="search-page__header">
            <p class="eyebrow">FIND YOUR STAY</p>
            <h1 class="display-title">Hotels with a<br /><em>sense of place.</em></h1>
        </header>
        <partial name="_SearchForm" model="new SearchFormView(Model.Destinations, f, true)" />
        <div class="search-page__layout">
            <div data-island="SearchExperience"
                 data-hydrate="load"
                 data-props="@(PublicPageModel.IslandProps(new
                 {
                     filters = f,
                     amenities = Model.Data.Amenities.Select(x => new { x.Id, x.Name })
                 }))"></div>
            <section aria-label="Hotel search results">
                <div class="search-page__results-header">
                    <p><strong>@Model.Data.Total</strong> stays found</p>
                    <form class="search-page__sort" action="/search" method="get">
                        @foreach (var item in Model.Request.Query.Where(
                            x => x.Key != "sort" && x.Key != "page"))
                        {
                            foreach (var value in item.Value)
                            {
                                <input type="hidden" name="@item.Key" value="@value" />
                            }
                        }
                        <label class="label" for="sort-hotels">Sort by</label>
                        <div class="select">
                            <select id="sort-hotels" name="sort">
                                <option value="relevance"
                                    selected="@(f.Sort == "relevance")">Recommended</option>
                                <option value="price-asc"
                                    selected="@(f.Sort == "price-asc")">Price: low to high</option>
                                <option value="price-desc"
                                    selected="@(f.Sort == "price-desc")">Price: high to low</option>
                                <option value="rating"
                                    selected="@(f.Sort == "rating")">Guest rating</option>
                            </select>
                        </div>
                        <button class="button is-text" type="submit">Sort</button>
                    </form>
                </div>
                @if (Model.Data.Results.Count == 0)
                {
                    <div class="notification is-secondary">
                        <h2>No exact matches</h2>
                        <p>Try widening the price range or removing an amenity. <a
                            href="/search" class="search-page__clear-link">Clear all filters</a></p>
                    </div>
                }
                else
                {
                    <div class="search-page__results">
                        @foreach (var result in Model.Data.Results)
                        {
                            <partial name="_HotelCard" model="result.Hotel" />
                        }
                    </div>
                }
                @if (Model.Data.Pages > 1)
                {
                    <nav class="pagination search-page__pagination"
                         aria-label="Search result pages">
                        <ul class="pagination-list">
                            @for (var index = 1; index <= Model.Data.Pages; index++)
                            {
                                var isCurrent = index == f.Page;
                                <li>
                                    <a class="pagination-link @(isCurrent ? "is-current" : "")"
                                       aria-current="@(isCurrent ? "page" : null)"
                                       href="@Model.PageLink(index)">@index</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </section>
        </div>
    </div>
</div>
