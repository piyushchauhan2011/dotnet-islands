{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "snapshot-worker",
  "root": "apps/snapshot-worker",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "SNAPSHOT_REPO_ROOT=../.. go run .",
        "cwd": "apps/snapshot-worker"
      },
      "cache": false,
      "continuous": true
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "SNAPSHOT_REPO_ROOT=../.. go run . --once --drain",
        "cwd": "apps/snapshot-worker"
      },
      "cache": false
    }
  }
}
