{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "snapshot-worker",
  "root": "apps/snapshot-worker",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/snapshot-worker/worker.mjs",
        "cwd": "."
      },
      "cache": false,
      "continuous": true
    },
    "publish": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/snapshot-worker/worker.mjs --once --drain",
        "cwd": "."
      },
      "cache": false
    }
  }
}
